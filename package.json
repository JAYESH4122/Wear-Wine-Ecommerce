{
  "name": "",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev:db": "tsx scripts/check-docker-db.ts",
    "migrate": "cross-env NODE_ENV=production tsx scripts/migrate.ts",
    "build": "next build --webpack",
    "build:with-migrate": "pnpm migrate && next build --webpack",
    "check:live-readiness": "tsx scripts/check-live-readiness.ts",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:with-migrate": "pnpm migrate && pnpm dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "start:with-migrate": "pnpm migrate && pnpm start",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "regenerate:media-sizes": "tsx scripts/regenerate-media-sizes.ts",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "seed": "tsx ./src/seed/index.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@next/env": "16.2.12",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/email-resend": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-s3": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@react-oauth/google": "^0.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "cva": "^0.0.0",
    "dotenv": "16.4.7",
    "framer-motion": "^12.36.0",
    "google-auth-library": "^10.6.2",
    "graphql": "^16.8.1",
    "gsap": "^3.14.2",
    "lucide-react": "^0.577.0",
    "next": "16.2.12",
    "next-auth": "4.24.15",
    "ogl": "^1.0.11",
    "payload": "3.86.0",
    "razorpay": "2.9.8",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-icons": "^5.6.0",
    "sharp": "0.35.3",
    "sonner": "^2.0.7",
    "swiper": "^12.1.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/prompts": "^2.4.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "28.0.0",
    "postcss": "8.5.23",
    "prettier": "^3.4.2",
    "prompts": "2.4.2",
    "tailwindcss": "^4.2.1",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "anymatch>picomatch": "2.3.2",
      "axios": "1.18.1",
      "cosmiconfig>yaml": "1.10.3",
      "dompurify": "3.4.12",
      "fast-uri": "3.1.4",
      "fast-xml-builder": "1.1.7",
      "fast-xml-parser": "5.7.0",
      "follow-redirects": "1.16.0",
      "form-data": "4.0.6",
      "happy-dom": "20.8.9",
      "immutable": "4.3.9",
      "js-yaml": "4.3.0",
      "lodash": "4.18.1",
      "micromatch>picomatch": "2.3.2",
      "postcss": "8.5.23",
      "readdirp>picomatch": "2.3.2",
      "sharp": "0.35.3",
      "tinyglobby>picomatch": "4.0.4",
      "ws": "8.21.0"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
