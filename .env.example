DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/wearvine
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXTAUTH_SECRET=YOUR_SECRET_HERE
NEXTAUTH_URL=http://localhost:3000
RATE_LIMIT_SALT=YOUR_RANDOM_32_BYTE_SECRET_HERE
NEXT_PUBLIC_API_URL=http://localhost:3000
PAYLOAD_CORS_ORIGINS=http://localhost:3000
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=support@example.com
EMAIL_FROM_NAME=Wear Vine

# Use test credentials only in Development/Preview. Keep this false until the
# database migration and Razorpay webhook have been verified in that environment.
PAYMENTS_ENABLED=false
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_32_BYTE_SECRET

# Start the nonce-based policy in report-only mode. Enforce only after checking
# production CSP reports and confirming Razorpay Checkout is not blocked.
CSP_ENFORCE=false
